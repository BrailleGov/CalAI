# Optional Cloudflare Worker. Leave blank to query Open Food Facts directly.
# AI photo/text logging, the AI coach, recipe generation, encrypted cloud backup, and SMS
# also require this base URL. Only public build-time values belong here; never put API keys
# in VITE_* variables because they are shipped to the browser.
VITE_API_BASE=

# Public VAPID key for Web Push (safe to expose). The private key stays in the Worker.
VITE_VAPID_PUBLIC_KEY=
